{
  "name": "dty-crypto-terminal",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:demo": "vite --open /demo/",
    "data": "node scripts/fetch-leaderboard.mjs && node scripts/fetch-news.mjs",
    "build": "node scripts/fetch-leaderboard.mjs && node scripts/fetch-news.mjs && npm run build:pages",
    "build:pages": "tsc -p tsconfig.json && vite build && vite build --mode demo && vite build --mode beli && vite build --mode admin",
    "build:nodata": "npm run build:pages",
    "build:demo": "tsc -p tsconfig.json && vite build --mode demo --outDir dist-demo --emptyOutDir",
    "serve:local": "node scripts/serve-local.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@netlify/blobs": "^11.1.3",
    "lightweight-charts": "^5.2.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@netlify/edge-functions": "^4.0.2",
    "@netlify/functions": "^6.0.2",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "typescript": "~5.9",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  }
}
