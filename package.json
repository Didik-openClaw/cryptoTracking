{
  "name": "hyperliquid-whale-tracker",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:demo": "vite --open /demo.html",
    "data": "node scripts/fetch-leaderboard.mjs",
    "build": "node scripts/fetch-leaderboard.mjs && tsc -p tsconfig.json && vite build",
    "build:nodata": "tsc -p tsconfig.json && vite build",
    "build:demo": "tsc -p tsconfig.json && vite build --mode demo",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "lightweight-charts": "^5.2.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "typescript": "~5.9",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  }
}
